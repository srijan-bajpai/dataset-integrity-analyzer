# ============================================================
# Dataset Integrity Analyzer (DIA) 2.0 - Environment Config
# ============================================================

# Secret password required to access, upload datasets, and run audits
DIA_SHARED_PASSWORD=replace-with-a-secure-studio-password

# PostgreSQL Database Configuration
POSTGRES_DB=dia
POSTGRES_USER=dia
POSTGRES_PASSWORD=replace-with-a-secure-database-password

# Optional: Host port (defaults to 8000)
PORT=8000

# Optional: Database URL (automatically constructed in docker-compose, or point to AWS RDS)
# DIA_DATABASE_URL=postgresql+psycopg2://dia:password@your-rds-endpoint.amazonaws.com:5432/dia

# Optional: Storage directory on host/container
DIA_STORAGE_DIR=/data

# Optional: Allowed CORS origins (* for any, or comma-separated list like https://dia.yourcompany.com)
DIA_CORS_ORIGINS=*

# Performance & Analysis Limits
DIA_MAX_SAMPLES=2000
DIA_MAX_UPLOAD_MB=200
DIA_MAX_EXTRACTED_MB=500
DIA_MAX_IMAGE_MB=25
DIA_WORKER_POLL_SECONDS=2
